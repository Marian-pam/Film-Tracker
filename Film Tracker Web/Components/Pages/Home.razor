@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@* This tells the page to look inside your new Models folder*@
@using Film_Tracker_Web.Models

<PageTitle>Film Tracker</PageTitle>

<h1> Film Tracker</h1>
<p>Search for a film or TV show to find out where it's streaming.</p>

@* --- The Search Bar --- *@
<div style="margin-bottom: 20px;">
    @* @bind connects what the user types directly into our C# searchQuery variable *@
    <input @bind="searchQuery" placeholder="e.g. Avatar" style="padding: 5px; width: 300px;" />
    
    @* @onclick tells the button to run our PerformSearch C# method! *@
    <button @onclick="PerformSearch" style="padding: 5px 10px; ">Search</button>
</div>


@* --- The Results --- *@
@if (isLoading)
{
    <p><em>Searching TMDB...</em></p>    
}
else if (searchResults != null)
{
    
    @if (selectedMedia != null)
    {
        <div style="background-color: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #ddd;">
        <h3 style="margin-topL 0;">Streaming for: @selectedMedia.DisplayName</h3>
        
        @if (currentProviders == null)
            {
                <p>Loading...</p>
            }
            else if (currentProviders.Count ==0)
            {
                <p style"color: red;">Not currently streaming on any subscription service in the UK.</p>
            }
            else
            {
                <ul>
                    @foreach (ProviderInfo provider in currentProviders)
                    {
                        <li> @provider.ProviderName</li>
                    }
                </ul>
            }
            </div>
            }



    <ul>
        @foreach (Media media in searchResults)
        {
            @if(media.MediaType != "person") // Hides actors from results'
            {
                @* "Style" (CSS) is used to tell the browser how to draw this specific item, "display" tells it to put the image and the text side by side*@
                <li style="display: flex; gap: 15px; margin-bottom: 15px; align-items: center;">
                    <img src="@media.FullPosterUrl" alt="Poster for @media.DisplayName" style="width: 100px; border-radius: 8px; box-shadow: 2px 2px 5px gray;" />

                    <div>
                        <strong>[@media.MediaType.ToUpper()</strong>
                        <span style="font-size: 1.2rem; font-weight: bold;">@media.DisplayName</span>
                        <br /> @* <br /> forces a line break, like hitting Enter on your keyboard*@
                        <span style="color: gray;">Released: @media.DisplayDate</span>
                        
                        <br />
                        <button @onclick="() => CheckProviders(media)" style="margin-top: 10px; padding: 5px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
                            Where to watch?
                        </button>


                        @*Line 76 doesn't have a function yet, but button appears on the screen and is able to be clicked (Progress...)*@
                        <button @onclick="() => AddWishlist(media)" style="margin-top: 10px; padding: 5px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
                            Add to Wishlist
                        </button>

                    </div>
                </li>
            }
        }
    </ul>   
        
}

@code {

    // These replace console variables
    private string searchQuery = "";
    private List<Media> searchResults;
    private bool isLoading = false;

    private Media selectedMedia;
    private List<ProviderInfo> currentProviders;

    // This method runs when the Search button is clicked
    private async Task PerformSearch()
    {


        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        selectedMedia = null; // Clear previous provider results
        currentProviders = null;

        isLoading = true; // Shows the Searching... text

        // This is your exact C# console code!
        using HttpClient client = new HttpClient();
        string safeSearchQuery = Uri.EscapeDataString(searchQuery);
        string url = $"https://api.themoviedb.org/3/search/multi?query={safeSearchQuery}&api_key=c59abf43762dd8a06f11594d0d89b6cf";

        HttpResponseMessage response = await client.GetAsync(url);
        string rawData = await response.Content.ReadAsStringAsync();

        TmdbResponse movieData = JsonSerializer.Deserialize<TmdbResponse>(rawData);

        // Save the results to our variable so the HTML can draw them
        if (movieData != null)
        {
            searchResults = movieData.Results;
        }

        isLoading = false; // Hides the Searching... text
    }

    private async Task CheckProviders(Media media)
    {
        selectedMedia = media; // Remembers which one they clicked
        currentProviders = null; // Clear out any old results

        using HttpClient client = new HttpClient();

        string urlType = media.MediaType == "tv" ? "tv" : "movie";
        string url = $"https://api.themoviedb.org/3/{urlType}/{media.Id}/watch/providers?api_key=c59abf43762dd8a06f11594d0d89b6cf";

        HttpResponseMessage response = await client.GetAsync(url);
        string rawData = await response.Content.ReadAsStringAsync();
        ProviderResponse providerData = JsonSerializer.Deserialize<ProviderResponse>(rawData);

        // Safely check if GB (UK) Flatrate (Subscription) data exists
        if (providerData?.Results?.GB?.Flatrate != null)
        {
            currentProviders = providerData.Results.GB.Flatrate;
        }
        else
        {
            currentProviders = new List<ProviderInfo>(); // Empty list means no providers found
        }
    }

    private async Task AddWishlist(Media media)
    {
        throw new NotImplementedException();
    }

}